{
  "name": "thementalgain",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "bake:site": "python site/scripts/bake_all_from_md.py",
    "deploy": "npm run bake:site && npx wrangler pages deploy site --project-name=thementalgain",
    "deploy:only": "npx wrangler pages deploy site --project-name=thementalgain",
    "legacy:render-home": "python site/scripts/render_home_from_md.py || python legacy/pilot-site/scripts/render_home_from_md.py"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
