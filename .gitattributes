# Text files are stored and checked out with LF line endings.
# eol=lf overrides core.autocrlf=true (the Git for Windows default), which would
# otherwise convert files to CRLF on checkout and fight the bake scripts,
# which always write LF.
* text=auto eol=lf

# Binary files: never convert line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.JPG  binary
*.gif  binary
*.webp binary
*.ico  binary
*.docx binary
*.pdf  binary
