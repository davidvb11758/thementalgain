---
import { siteConfig } from '../../lib/site.ts';
---
<header class="relative z-20 bg-tmg-surface">
  <div class="container-content flex items-center justify-between gap-5 py-2.5">
    <a href="/" class="block shrink-0" aria-label={`${siteConfig.name} – home`}>
      <img src="/images/logo.png" alt={siteConfig.name} width="280" height="142" class="h-auto w-[220px] max-w-full lg:w-[280px]" />
    </a>
    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex flex-wrap justify-end">
        {
          siteConfig.primaryMenu.map((item) => (
            <li class="relative group">
              <a
                href={item.href}
                class="block px-5 py-2 text-sm uppercase tracking-wide text-tmg-nav transition-colors hover:text-tmg-heading"
              >
                {item.label}
              </a>
              {item.children && item.children.length > 0 && (
                <ul class="absolute right-0 top-full hidden min-w-[14rem] rounded bg-tmg-surface-elevated py-2 shadow-[var(--shadow-card)] group-hover:block group-focus-within:block">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="block px-4 py-2 text-sm text-tmg-nav hover:text-tmg-heading">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="text-sm text-tmg-text-muted lg:hidden">Menu (mobile nav — implement when building pages)</p>
  </div>
</header>
