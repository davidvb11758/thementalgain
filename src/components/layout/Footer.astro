---
import { siteConfig } from '../../lib/site.ts';
const year = new Date().getFullYear();
---
<footer class="bg-tmg-footer text-white">
  <div class="container-content grid gap-10 py-16 md:grid-cols-3 md:gap-16">
    <div>
      <h2 class="mb-4 text-2xl text-white">Let's work together.</h2>
      <p class="mb-6 text-base leading-relaxed">
        Take the first step toward improved mental performance. The time is right to improve your mental game.
      </p>
      <a href="/about/#contact" class="inline-block rounded bg-white px-5 py-2.5 text-tmg-accent transition-colors hover:bg-tmg-heading hover:text-white">
        Contact Me
      </a>
    </div>
    <div>
      <h4 class="mb-6 text-xl text-white">Quick links</h4>
      <ul class="space-y-1">
        {siteConfig.footerQuickLinks.map((link) => (
          <li>
            <a href={link.href} class="text-base hover:underline">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4 class="mb-6 text-xl text-white">Connect</h4>
      {
        siteConfig.social.instagram && (
          <a
            href={siteConfig.social.instagram}
            class="text-base underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        )
      }
    </div>
  </div>
  <p class="container-content pb-8 text-base">© {year} TheMentalGain.com</p>
</footer>
