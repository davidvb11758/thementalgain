---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageTitle, siteConfig } from '../lib/site.ts';

const title = pageTitle('');
const description =
  'Certified Mental Performance Consultant helping athletes, teams, and individuals build confidence, focus, and resilience.';
---
<BaseLayout title={title} description={description}>
  <section class="container-content py-[var(--spacing-section)]">
    <h1 class="mb-4 border-l border-tmg-heading pl-6">{siteConfig.name}</h1>
    <p class="mb-6 max-w-2xl text-tmg-heading">{siteConfig.tagline}</p>
    <div class="card max-w-3xl prose-tmg">
      <h2 class="mb-3">Staging site scaffold</h2>
      <p>
        This Astro + Tailwind + Markdown project is set up per <strong>TMG rqmts.docx</strong>.
        Page implementations are added incrementally—content lives in <code>content/pages/</code>.
      </p>
      <p class="mt-4 text-tmg-text-muted text-[length:var(--text-small)]">
        Legacy static pilot: <code>legacy/pilot-site/</code> (previous HTML/CSS prototype).
      </p>
    </div>
  </section>
</BaseLayout>
