# Copy to .env (local only). Never commit .env.
# Cloudflare Pages: set these in Dashboard → Settings → Environment variables.

# Contact form (e.g. Formspree, Web3Forms) — server-side / Pages Function only
# PUBLIC_* vars are embedded in client bundles; do not put secrets in PUBLIC_.
# FORM_ENDPOINT=

# Newsletter provider endpoint (when wired)
# NEWSLETTER_ENDPOINT=

# Google Calendar scheduling embed URL (Booking page)
# PUBLIC_BOOKING_URL=
